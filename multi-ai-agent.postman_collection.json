              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response body is not empty\", function () {",
                  "    pm.expect(pm.response.text().trim()).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        }
