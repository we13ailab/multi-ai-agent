    },
    {
      "name": "3. Multi-Agent Workflow",
      "description": "Requests against `GET /api/ai-support/workflow` — the WorkflowSupportAgent sequence: OrderAgent (getOrderStatus tool) -> RefundAgent (checkRefundEligibility tool) -> ResponseAgent.\n\nWatch the console for `=== AGENT START ===` / `TOOL CALLED -> ...` / `=== AGENT END ===` log lines — each request should run the full three-agent pipeline.",
      "item": [
        {
          "name": "3.1 Refund request (full pipeline)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support/workflow?request=Can I get a refund for my order {{orderId1}}?",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support", "workflow"],
              "query": [
                {
                  "key": "request",
                  "value": "Can I get a refund for my order {{orderId1}}?"
                }
              ]
            },
            "description": "Happy path — OrderAgent fetches the order, RefundAgent checks refund eligibility against the refund_policy table, ResponseAgent composes the final customer answer. Expect getOrderStatus + checkRefundEligibility tool calls in the console."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 500\", function () {",
                  "    pm.expect([200, 500]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"Response body is not empty\", function () {",
                  "    pm.expect(pm.response.text().trim()).to.not.be.empty;",
                  "});",
                  "console.log(\"Workflow response:\", pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Refund request on a different order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support/workflow?request=I want a refund for order {{orderId2}} please",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support", "workflow"],
              "query": [
                {
                  "key": "request",
                  "value": "I want a refund for order {{orderId2}} please"
                }
              ]
            },
            "description": "Second order through the same pipeline — useful to compare refund decisions across different order statuses (e.g. Shipped vs Processing)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 500\", function () {",
                  "    pm.expect([200, 500]).to.include(pm.response.code);",
                  "});",
                  "console.log(\"Workflow response:\", pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Refund request for an unknown order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support/workflow?request=Please refund my order ORD-9999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support", "workflow"],
              "query": [
                {
                  "key": "request",
                  "value": "Please refund my order ORD-9999"
                }
              ]
            },
            "description": "Negative scenario — the OrderAgent's getOrderStatus tool throws OrderNotFoundException (visible to the LLM). The workflow should fail gracefully or surface the error — never invent order details."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 500\", function () {",
                  "    pm.expect([200, 500]).to.include(pm.response.code);",
                  "});",
                  "console.log(\"Workflow response:\", pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 Mixed status + refund question",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai-support/workflow?request=Where is my order {{orderId1}} and can it still be refunded?",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai-support", "workflow"],
              "query": [
                {
                  "key": "request",
                  "value": "Where is my order {{orderId1}} and can it still be refunded?"
                }
              ]
            },
            "description": "Compound request — exercises the full sequence with both order-location and refund-eligibility aspects in a single customer question."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 500\", function () {",
                  "    pm.expect([200, 500]).to.include(pm.response.code);",
                  "});",
                  "console.log(\"Workflow response:\", pm.response.text());"
                ]
              }
            }
          ]
        }
      ]
    },
    {
